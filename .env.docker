# Docker Environment File Template
# Copy this to .env and update with your production values

# Database credentials
DB_ROOT_PASSWORD=your_secure_root_password_here
DB_DATABASE=payhouse
DB_USERNAME=payhouse_user
DB_PASSWORD=your_secure_password_here

# Redis
REDIS_PASSWORD=

# Application
APP_KEY=
# Generate with: docker-compose run --rm app php artisan key:generate --show
